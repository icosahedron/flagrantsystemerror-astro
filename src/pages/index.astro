---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

const coverImage = '/flagrant-banner.png';

// The home page mirrors the Notion root page: icon + title + intro, then the
// collection of posts. The intro lives in src/content/pages/home.md so it's
// editable like any other content.
const home = await getEntry('pages', 'home');
const { Content } = await home.render();

// Drafts show in `npm run dev` but are excluded from the production build.
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout coverImage={coverImage}>
  <div class="home-header">
    <img class="site-icon" src="/images/site-icon.svg" alt="" />
    <h1 class="notion-title">{SITE_TITLE}</h1>
  </div>
  <Content />
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/${post.slug}/`} class="post-link">
          {post.data.heroImage && (
            <img
              class="post-thumb"
              src={post.data.heroImage}
              alt=""
              loading="lazy"
              style={`object-position: center ${((1 - (post.data.heroImagePosition ?? 0.5)) * 100).toFixed(2)}%`}
            />
          )}
          <span class="post-body">
            <span class="post-title">
              {post.data.icon && <span class="post-icon">{post.data.icon}</span>}
              {post.data.title}
            </span>
            {post.data.description && (
              <span class="post-desc">{post.data.description}</span>
            )}
            <FormattedDate date={post.data.pubDate} />
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  /* Home header: icon overlapping the cover, then the site title — like the
     Notion root page. */
  .home-header {
    display: flex;
    flex-direction: column;
  }
  .site-icon {
    width: 60px;
    height: 60px;
    margin-top: -3rem;
    margin-bottom: 0.25rem;
  }
  .notion-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0.5rem 0 0.5rem;
    color: var(--fg-color, rgb(55, 53, 47));
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .post-item {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--fg-color-0, rgba(55, 53, 47, 0.09));
  }
  .post-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .post-thumb {
    flex: 0 0 auto;
    width: 120px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--fg-color-0, rgba(55, 53, 47, 0.09));
  }
  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .post-title {
    font-weight: 600;
    font-size: 1.15rem;
  }
  .post-icon {
    margin-right: 0.4rem;
  }
  .post-link:hover .post-title {
    text-decoration: underline;
  }
  .post-desc {
    color: var(--fg-color-3, rgba(55, 53, 47, 0.6));
    font-size: 0.95rem;
  }
  .post-item :global(time) {
    color: var(--fg-color-2, rgba(55, 53, 47, 0.4));
    font-size: 0.8rem;
    margin-top: 0.2rem;
  }
  @media (max-width: 520px) {
    .post-thumb { width: 84px; height: 60px; }
  }
</style>
