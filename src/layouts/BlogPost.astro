---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'> | CollectionEntry<'pages'>;
	showMeta?: boolean;
}

const { post, showMeta = true } = Astro.props;
const { title, description } = post.data;
const pubDate = 'pubDate' in post.data ? post.data.pubDate : undefined;
const updatedDate = 'updatedDate' in post.data ? post.data.updatedDate : undefined;
const heroImage = 'heroImage' in post.data ? post.data.heroImage : undefined;
const heroImagePosition = 'heroImagePosition' in post.data ? post.data.heroImagePosition : undefined;
const icon = 'icon' in post.data ? post.data.icon : undefined;
---
<Layout title={title} description={description} coverImage={heroImage} coverPosition={heroImagePosition}>
  <article class:list={['notion-page-content-inner', { 'has-cover': heroImage }]}>
    {icon && <div class="page-icon" role="img">{icon}</div>}
    <h1 class="notion-title">{title}</h1>
    {showMeta && pubDate && (
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span> · Updated <FormattedDate date={updatedDate} /></span>
        )}
      </div>
    )}
    <slot />
  </article>
</Layout>

<style>
  /* Notion overlaps the page icon on the bottom-left of the cover. */
  .page-icon {
    font-size: 64px;
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .has-cover .page-icon {
    margin-top: -3rem;
  }
  .notion-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0.5rem 0 0.25rem;
    color: var(--fg-color, rgb(55, 53, 47));
  }
  .post-meta {
    color: var(--fg-color-3, rgba(55, 53, 47, 0.6));
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
</style>
