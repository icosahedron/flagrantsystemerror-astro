---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'> | CollectionEntry<'pages'>;
	showMeta?: boolean;
}

const { post, showMeta = true } = Astro.props;
const { title, description } = post.data;
const pubDate = 'pubDate' in post.data ? post.data.pubDate : undefined;
const updatedDate = 'updatedDate' in post.data ? post.data.updatedDate : undefined;
---
<Layout title={title} description={description}>
  <article class="notion-page-content-inner">
    <h1 class="notion-title">{title}</h1>
    {showMeta && pubDate && (
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span> · Updated <FormattedDate date={updatedDate} /></span>
        )}
      </div>
    )}
    <slot />
  </article>
</Layout>

<style>
  .notion-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0.5rem 0 0.25rem;
    color: var(--fg-color, rgb(55, 53, 47));
  }
  .post-meta {
    color: var(--fg-color-3, rgba(55, 53, 47, 0.6));
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
</style>
